# Root-level reference only. Copy values into each app-specific `.env` file.

# Server env vars (used in /server/.env)
GEMINI_API_KEY=PASTE_YOUR_GEMINI_KEY_HERE
ELEVENLABS_API_KEY=PASTE_YOUR_ELEVENLABS_KEY_HERE
ELEVENLABS_ATC_VOICE_ID=PASTE_YOUR_ELEVENLABS_VOICE_ID_HERE
MONGODB_URI=******CLUSTER.mongodb.net/squawk?retryWrites=true&w=majority
MONGODB_DB=squawk
CORS_ORIGINS=http://localhost:3000
GEMINI_MODEL=gemini-2.5-flash

# Web env vars (used in /web/.env.local)
NEXT_PUBLIC_SERVER_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_SESSION_ID=

# Pi env vars (used in /pi/.env)
PI_SERVER_WS_URL=ws://localhost:8000/ws/session/demo
