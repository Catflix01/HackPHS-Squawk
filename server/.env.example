# Google Gemini API key (grading + AI tower replies).
GEMINI_API_KEY=PASTE_YOUR_GEMINI_KEY_HERE

# ElevenLabs API key (speech-to-text and text-to-speech).
ELEVENLABS_API_KEY=PASTE_YOUR_ELEVENLABS_KEY_HERE

# ElevenLabs voice ID for the AI tower controller voice.
ELEVENLABS_ATC_VOICE_ID=PASTE_YOUR_ELEVENLABS_VOICE_ID_HERE

# Optional: ElevenLabs voice ID for the AI flight instructor (CFI). Falls back to the ATC voice.
ELEVENLABS_CFI_VOICE_ID=

# true = skip all AI calls and use canned transcripts/replies/scores (safe demo, no keys needed).
# Even when false, any AI call that fails or takes > 5 s falls back to canned output.
DEMO_MODE=false

# Optional: MongoDB Atlas connection string. Leave empty to keep transmissions in memory only.
MONGODB_URI=

# Optional DB name override (defaults to "squawk").
MONGODB_DB=squawk

# Allowed web origins for CORS (comma-separated). Defaults to localhost and 127.0.0.1 on
# ports 3000, 3001 and 3002 (the ports Next.js dev falls through to). Add the Mac's LAN URL
# for the Pi kiosk, e.g. ...,http://192.168.1.20:3000  — or "*" to allow any origin.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002

# Optional Gemini model override. Comma-separated = fallback chain tried in order
# (busy/retired models are skipped). gemini-2.5-flash is retired for new keys.
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.8-flash

# Optional scenario file name in server/scenarios/ (without .json).
SCENARIO=vfr_pattern
