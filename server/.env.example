# Google Gemini API key for ATC feedback generation.
GEMINI_API_KEY=PASTE_YOUR_GEMINI_KEY_HERE

# ElevenLabs API key used for speech-to-text and text-to-speech calls.
ELEVENLABS_API_KEY=PASTE_YOUR_ELEVENLABS_KEY_HERE

# ElevenLabs voice ID for the AI tower controller voice.
ELEVENLABS_ATC_VOICE_ID=PASTE_YOUR_ELEVENLABS_VOICE_ID_HERE

# MongoDB Atlas connection string used to store transmission history.
MONGODB_URI=******CLUSTER.mongodb.net/squawk?retryWrites=true&w=majority

# Optional DB name override (defaults to "squawk").
MONGODB_DB=squawk

# Allowed web origins for CORS (comma-separated).
CORS_ORIGINS=http://localhost:3000

# Optional Gemini model override.
GEMINI_MODEL=gemini-2.5-flash
