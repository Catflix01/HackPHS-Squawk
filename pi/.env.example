# Server WebSocket base URL: ws://<server-LAN-IP>:<port>  (the Mac running FastAPI — not localhost).
# ptt.py appends /ws/session/<PI_SESSION_ID>?role=device. A full URL with /ws/session/... also works.
PI_SERVER_WS_URL=ws://192.168.1.20:8000

# Session to join. Must match the session the kiosk and the controller use.
PI_SESSION_ID=DEMO

# PTT button GPIO (BCM numbering). Grove button on Base HAT port D16 -> 16.
PTT_GPIO=16

# false = pull-down, for the Grove button (outputs HIGH when pressed).
# true  = pull-up, for a bare button wired between the GPIO pin and GND.
PTT_PULL_UP=false

# First line of the LCD (Grove LCD RGB Backlight on any I2C port: text 0x3e, RGB 0x62).
PI_FREQ_LABEL=TWR 118.5

# Web app URL for the Chromium kiosk (kiosk.sh), again by LAN IP.
WEB_URL=http://192.168.1.20:3000
